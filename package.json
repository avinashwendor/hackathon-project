{
  "name": "upstream",
  "version": "1.0.0",
  "private": false,
  "description": "Upstream — an AI recommendation agent that turns short-form scrolling into technical momentum.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "embed": "node scripts/build-embeddings.mjs",
    "sync:s3": "node scripts/sync-catalog-s3.mjs",
    "sync:auth-s3": "node scripts/sync-auth-assets-s3.mjs",
    "verify:media": "node scripts/verify-media.mjs",
    "transcode": "node scripts/transcode.mjs",
    "agent:eval": "node scripts/eval-agent.mjs",
    "eval:submission": "node scripts/eval-submission.mjs",
    "test": "node --import ./tests/register.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "test:watch": "node --import ./tests/register.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --watch tests/*.test.mjs",
    "import:catalog": "node scripts/import-catalog.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@monaco-editor/react": "^4.6.0",
    "@webcontainer/api": "1.6.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.0",
    "kysely": "^0.29.5",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
