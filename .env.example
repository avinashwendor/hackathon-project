# ── LLM (required for the full agent; the app degrades gracefully without it) ──
OMEGA_API_KEY=
OMEGA_BASE_URL=https://api.omegaplusapi.com/v1
OMEGA_MODEL=claude-sonnet-4-6

# ── Embeddings ────────────────────────────────────────────────────────────────
# With a key: Google text-embedding-004 (free tier, 768d).
# Without:    deterministic local hybrid embeddings (384d). Everything still works.
GOOGLE_API_KEY=
EMBEDDING_PROVIDER=google

# ── Vector store ──────────────────────────────────────────────────────────────
# Unset  → in-process exhaustive cosine (correct and fast for this corpus).
# Set    → Qdrant (Railway template or Qdrant Cloud free tier).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=upstream_reels

# ── Media storage (S3 or any S3-compatible: R2, MinIO, Backblaze) ─────────────
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# ── Tuning ────────────────────────────────────────────────────────────────────
AGENT_SUBSTANCE_FLOOR=0.45
AGENT_MMR_LAMBDA=0.72
AGENT_HALF_LIFE_MINUTES=240
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth (required in production) ─────────────────────────────────────────────
AUTH_SECRET=
