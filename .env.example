# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=

# ── Database (Railway Postgres) ───────────────────────────────────────────────
# Set automatically when you add a Postgres plugin and link it to this service.
# Run migrations/001_init.sql once in the Railway Postgres Query tab.
DATABASE_URL=

# ── LLM (optional — agent degrades without it) ─────────────────────────────────
OMEGA_API_KEY=
OMEGA_BASE_URL=https://api.omegaplusapi.com/v1
OMEGA_MODEL=claude-sonnet-4-6

# ── Embeddings (Google AI Studio — recommended for PromptWars scoring) ─────────
# Either key works. With a key: gemini-embedding-001 @ 768d, cached on disk.
# Without: deterministic local hybrid @ 384d.
GEMINI_API_KEY=
GOOGLE_API_KEY=
EMBEDDING_PROVIDER=google
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMS=768

# ── Vector store (Railway Qdrant template) ────────────────────────────────────
# Unset  → in-process cosine search (works, resets each deploy).
# Set    → Qdrant collection `upstream_reels` — vectors persist across deploys.
VECTOR_DRIVER=qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=upstream_reels

# ── Media storage (S3 / Cloudflare R2 — required for real video on Railway) ─
# Videos are NOT in git (~943MB). Upload once with: npm run sync:s3 -- --dir <path>
# Auth login preview (webm + poster): npm run sync:auth-s3
# STORAGE_DRIVER auto-detects from S3_BUCKET; set explicitly to "s3" on Railway.
STORAGE_DRIVER=
REELS_CATALOG_DIR=
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# ── Agent tuning ──────────────────────────────────────────────────────────────
AGENT_SUBSTANCE_FLOOR=0.45
AGENT_MMR_LAMBDA=0.72
AGENT_HALF_LIFE_MINUTES=240
